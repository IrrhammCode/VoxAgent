# Vox Agent — Environment Variables
# Copy file ini atau gunakan config.js

# Anakin.io API Key (Anakin Forge Hackathon)
# Dapatkan API key dari dashboard Anakin.io: https://anakin.io
ANAKIN_API_KEY=

# Set ke true jika ingin mengaktifkan Live Scrape secara default
ANAKIN_LIVE_SCRAPE=false

# Port/Endpoint
ANAKIN_SCRAPE_ENDPOINT=https://api.anakin.io/v1/scrape

# Groq API Key (Opsional: untuk LLM super cepat via Llama 3.3, gratis di https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ElevenLabs TTS (Opsional: suara manusia ultra-realistis, gratis 10k karakter/bulan)
# Dapatkan di https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
